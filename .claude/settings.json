{
  "permissions": {
    "allow": [
      "Bash(esphome compile *)",
      "Bash(esphome logs *)",
      "Bash(esphome run *)",
      "Bash(esphome config *)",
      "Bash(esphome version)",
      "Bash(make *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-stop-check.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
