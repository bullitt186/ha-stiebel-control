# secrets.yaml — copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored and must NEVER be committed.

# Wi-Fi credentials
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# MQTT broker (IP address or hostname)
mqtt_broker: 192.168.1.10
mqtt_username: "your_mqtt_user"
mqtt_password: "your_mqtt_password"

# ESPHome API and OTA encryption key (32-byte base64 — generate for NEW devices with:
# python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())" )
# Keep the existing key for installed devices and Home Assistant integration.
api_encryption_key: "your-32-byte-base64-key-here=="

# OTA migration, stage 1: keep the existing password on installed devices.
# The password remains required by the shipped common.yaml until stage 2.
ota_password: "your-ota-password"
# Stage 2 will require encryption with the existing API key and remove this secret.
# See docs/INSTALLATION.md#ota-encryption-migration.
